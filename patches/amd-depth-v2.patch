+
+vk::ImageView NativeRenderer::ResolvedDepthView(const Native::ImageEntry& entry,
+                                                const VideoCore::ImageViewInfo& requested) {
+    // FIX-AMD-001: GT7's PS4 Pro mode draws its checkerboard with a 2-sample depth buffer and
+    // its atmosphere pass (and a compute pass before it) samples that buffer through a
+    // single-sample T#. A single-sample view of a multisampled image is not valid Vulkan: NVIDIA
+    // returned sample 0, but on an RX 6900 XT the bottom 4 rows of each 8x8 tile read other
+    // data, and the atmosphere pass painted the sky's colour there (horizontal blue or orange
+    // dashes over the whole scene, 8x4 blocks of the 1920x2160 surface). The shader now reads a
+    // single-sample copy of sample 0, which is what the console's T# reads. Called with
+    // views_mutex held.
+    if (!MsaaDepthResolveOn()) {
+        return {};
+    }
+    auto& resolve = depth_resolves[&entry];
+    if (resolve.source != entry.image.get() || !resolve.image) {
+        if (resolve.image) {
+            retired_depth_resolves.push_back(std::move(resolve)); // the GPU may still read it
+            resolve = {};
+        }
+        auto desc = entry.image->Desc();
+        desc.samples = 1;
+        desc.mips = 1;
+        desc.layers = 1;
+        desc.usage = Native::Rhi::ImageUsageSampled | Native::Rhi::ImageUsageDepthTarget;
+        desc.name = "msaa depth resolve";
+        resolve.image = device->CreateImage(desc);
+        if (!resolve.image) {
+            static std::atomic<u32> logged{};
+            if (Sample(logged)) {
+                LOG_WARNING(Render_Vulkan, "FIX-AMD-001: no resolve image for depth {:#x}",
+                            entry.info.guest_address);
+            }
+            depth_resolves.erase(&entry);
+            return {};
+        }
+        const Native::Rhi::ImageViewDesc view_desc{.aspect = Native::Rhi::AspectDepth};
+        resolve.source_view = device->CreateImageView(entry.image.get(), view_desc);
+        resolve.target_view = device->CreateImageView(resolve.image.get(), view_desc);
+        resolve.source = entry.image.get();
+        resolve.version = ~u64{0};
+        const vk::Format format = static_cast<vk::Format>(resolve.image->Desc().format);
+        auto [result, view] = r.instance.GetDevice().createImageViewUnique(vk::ImageViewCreateInfo{
+            .image = vk::Image{Handle<VkImage_T>(resolve.image->NativeHandle())},
+            .viewType = vk::ImageViewType::e2D,
+            .format = format,
+            .components = requested.mapping == AmdGpu::IdentityMapping
+                              ? vk::ComponentMapping{}
+                              : LiverpoolToVK::ComponentMapping(requested.mapping),
+            .subresourceRange{.aspectMask = vk::ImageAspectFlagBits::eDepth,
+                              .baseMipLevel = 0,
+                              .levelCount = 1,
+                              .baseArrayLayer = 0,
+                              .layerCount = 1},
+        });
+        if (result != vk::Result::eSuccess || !resolve.source_view || !resolve.target_view) {
+            depth_resolves.erase(&entry);
+            return {};
+        }
+        resolve.sampled_view = std::move(view);
+        static std::atomic<u32> logged{};
+        if (Sample(logged)) {
+            LOG_WARNING(Render_Vulkan,
+                        "FIX-AMD-001: depth {:#x} {}x{} ({} samples) is sampled through a "
+                        "single-sample T#: it reads a copy of sample 0",
+                        entry.info.guest_address, entry.image->Desc().width,
+                        entry.image->Desc().height, entry.image->Desc().samples);
+        }
+    }
+    return *resolve.sampled_view;
+}
