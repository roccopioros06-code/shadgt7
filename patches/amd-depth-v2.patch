+static bool DepthExpandOn() {
+    // FIX-AMD-002 (test): RYGT_DEPTH_SAMPLE_EXPAND=1 takes a depth target the work samples
+    // through a read-only layout and back before the work, so the driver decompresses it.
+    static const bool on = [] {
+        const char* env = std::getenv("RYGT_DEPTH_SAMPLE_EXPAND");
+        return env && env[0] == '1';
+    }();
+    return on;
+}
+
+void NativeRenderer::ResolveSampledDepth(const DrawBindings& b) {
+    Stream& s = stream;
+    bool barrier_done = false;
+    if (DepthExpandOn()) {
+        for (const auto* entry : b.sampled) {
+            if (!entry || !entry->info.props.is_depth || !entry->image) {
+                continue;
+            }
+            const u64 version = entry->write_version.load(std::memory_order_relaxed);
+            auto& expanded = depth_expanded[entry];
+            if (expanded == version) {
+                continue;
+            }
+            expanded = version;
+            if (!barrier_done) {
+                GlobalBarrier();
+                barrier_done = true;
+            }
+            const vk::ImageAspectFlags aspects =
+                vk::ImageAspectFlagBits::eDepth |
+                (entry->info.props.has_stencil ? vk::ImageAspectFlagBits::eStencil
+                                               : vk::ImageAspectFlags{});
+            const vk::ImageSubresourceRange range{.aspectMask = aspects,
+                                                  .baseMipLevel = 0,
+                                                  .levelCount = VK_REMAINING_MIP_LEVELS,
+                                                  .baseArrayLayer = 0,
+                                                  .layerCount = VK_REMAINING_ARRAY_LAYERS};
+            const vk::Image image{Handle<VkImage_T>(entry->image->NativeHandle())};
+            const vk::ImageMemoryBarrier2 to_read{
+                .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                .srcAccessMask = vk::AccessFlagBits2::eMemoryWrite,
+                .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                .dstAccessMask = vk::AccessFlagBits2::eMemoryRead,
+                .oldLayout = vk::ImageLayout::eGeneral,
+                .newLayout = entry->info.props.has_stencil
+                                 ? vk::ImageLayout::eDepthStencilReadOnlyOptimal
+                                 : vk::ImageLayout::eDepthReadOnlyOptimal,
+                .image = image,
+                .subresourceRange = range,
+            };
+            s.cmd.pipelineBarrier2(
+                vk::DependencyInfo{.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &to_read});
+            vk::ImageMemoryBarrier2 back = to_read;
+            back.oldLayout = to_read.newLayout;
+            back.newLayout = vk::ImageLayout::eGeneral;
+            back.srcAccessMask = vk::AccessFlagBits2::eMemoryRead;
+            back.dstAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite;
+            s.cmd.pipelineBarrier2(
+                vk::DependencyInfo{.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &back});
+            static std::atomic<u32> logged{};
+            if (logged.fetch_add(1, std::memory_order_relaxed) < 4) {
+                LOG_WARNING(Render_Vulkan, "FIX-AMD-002: depth {:#x} expanded before sampling",
+                            entry->info.guest_address);
+            }
+        }
+    }
+    // FIX-AMD-001: the copies the work reads are made now, after the depth writes before it.
+    if (!MsaaDepthResolveOn()) {
+        if (barrier_done) {
+            GlobalBarrier();
+        }
+        return;
+    }
+    for (const auto* entry : b.sampled) {
+        if (!entry || !entry->info.props.is_depth || !entry->image) {
+            continue;
+        }
+        DepthResolve* resolve = nullptr;
+        {
+            std::scoped_lock lock{views_mutex};
+            const auto it = depth_resolves.find(entry);
+            if (it == depth_resolves.end() || it->second.source != entry->image.get() ||
+                !it->second.image) {
+                continue;
+            }
+            resolve = &it->second;
+        }
+        const u64 version = entry->write_version.load(std::memory_order_relaxed);
+        if (resolve->version == version) {
+            continue;
+        }
+        if (!barrier_done) {
+            GlobalBarrier(); // ends the pass; the depth writes are done
+            barrier_done = true;
+        }
+        const auto& desc = resolve->image->Desc();
+        if (resolve->version == ~u64{0}) {
+            const vk::ImageMemoryBarrier2 transition{
+                .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                .dstAccessMask = vk::AccessFlagBits2::eMemoryWrite,
+                .oldLayout = vk::ImageLayout::eUndefined,
+                .newLayout = vk::ImageLayout::eGeneral,
+                .image = vk::Image{Handle<VkImage_T>(resolve->image->NativeHandle())},
+                .subresourceRange{.aspectMask = vk::ImageAspectFlagBits::eDepth |
+                                                (entry->info.props.has_stencil
+                                                     ? vk::ImageAspectFlagBits::eStencil
+                                                     : vk::ImageAspectFlags{}),
+                                  .baseMipLevel = 0,
+                                  .levelCount = 1,
+                                  .baseArrayLayer = 0,
+                                  .layerCount = 1},
+            };
+            s.cmd.pipelineBarrier2(
+                vk::DependencyInfo{.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &transition});
+        }
+        const vk::RenderingAttachmentInfo attachment{
+            .imageView = vk::ImageView{Handle<VkImageView_T>(resolve->source_view->NativeHandle())},
+            .imageLayout = vk::ImageLayout::eGeneral,
+            .resolveMode = vk::ResolveModeFlagBits::eSampleZero,
+            .resolveImageView =
+                vk::ImageView{Handle<VkImageView_T>(resolve->target_view->NativeHandle())},
+            .resolveImageLayout = vk::ImageLayout::eGeneral,
+            .loadOp = vk::AttachmentLoadOp::eLoad,
+            .storeOp = vk::AttachmentStoreOp::eStore,
+        };
+        s.cmd.beginRendering(vk::RenderingInfo{
+            .renderArea{.extent = {desc.width, desc.height}},
+            .layerCount = 1,
+            .pDepthAttachment = &attachment,
+        });
+        s.cmd.endRendering();
+        resolve->version = version;
+        ++s.commands;
+    }
+    if (barrier_done) {
+        GlobalBarrier(); // the copies are written before the work samples them
+    }
+}
