+static bool FeedbackCopyOn(const Instance& instance) {
+    static const int mode = [] {
+        const char* env = std::getenv("RYGT_FEEDBACK_COPY");
+        if (env && env[0] == '0') {
+            return 0;
+        }
+        if (env && env[0] == '1') {
+            return 1;
+        }
+        return 2;
+    }();
+    return mode == 1 || (mode == 2 && !instance.IsAttachmentFeedbackLoopLayoutSupported());
+}
+
+void NativeRenderer::CopyFeedbackTargets(const Native::ImageEntry* const* colors, size_t count,
+                                         const RenderState& wanted, DrawBindings& b) {
+    // FIX-AMD-003: GT7's PS4 Pro atmosphere pass (fs 0x2b49e735) draws into the 1920x2160
+    // checkerboard scene and samples that same picture to blend its fog over it. Without
+    // VK_EXT_attachment_feedback_loop_* (an RX 6900 XT has neither) the attachment state is not
+    // marked and the read is undefined: on AMD 8x4-pixel blocks (the bottom halves of 8x8 tiles)
+    // read nothing of the scene, and the pass left only its fog there, in horizontal dashes
+    // over the whole picture. The draw now samples a copy of the target taken just before it,
+    // which is what it reads on the console (its own pixel, before its write).
+    if (b.sampled.empty() || count == 0 || !FeedbackCopyOn(r.instance)) {
+        return;
+    }
+    Stream& s = stream;
+    bool copied = false;
+    bool resumed_pass = false;
+    RenderState current{};
+    for (size_t c = 0; c < count; ++c) {
+        const Native::ImageEntry* entry = colors[c];
+        if (!entry || !entry->image || entry->info.props.is_depth ||
+            std::ranges::find(b.sampled, entry) == b.sampled.end()) {
+            continue;
+        }
+        // FIX-AMD-003 (diagnosis): what happens to each draw that samples its own colour target.
+        static std::atomic<u32> big_logged{}, small_logged{};
+        const bool big = entry->info.size.width >= 1024;
+        const auto note = [&](const char* what, size_t n) {
+            std::atomic<u32>& counter = big ? big_logged : small_logged;
+            const u32 k = counter.fetch_add(1, std::memory_order_relaxed);
+            if (k < (big ? 400u : 20u) || k % 2000 == 0) {
+                LOG_WARNING(Render_Vulkan,
+                            "FIX-AMD-003 diag #{}: target {:#x} {}x{} frame {} {} ({}; {} images, {} "
+                            "sampled, pass open {})",
+                            k, entry->info.guest_address, entry->info.size.width,
+                            entry->info.size.height, frame, what, n, b.images.size(),
+                            b.sampled.size(), s.rendering);
+            }
+        };
+        if (!(vk::ImageUsageFlags{entry->backend_usage} & vk::ImageUsageFlagBits::eTransferSrc)) {
+            note("skipped: no transfer use", 0);
+            continue;
+        }
+        // The views of this target that the draw binds, and the views they ask for.
+        boost::container::small_vector<std::pair<size_t, std::pair<VideoCore::ImageViewInfo, ViewUse>>, 4>
+            slots;
+        {
+            std::scoped_lock lock{views_mutex};
+            const auto it = views.find(entry);
+            if (it == views.end()) {
+                note("skipped: no views recorded", 0);
+                continue;
+            }
+            for (size_t i = 0; i < b.images.size(); ++i) {
+                const vk::ImageView bound = b.images[i].imageView;
+                if (!bound) {
+                    continue;
+                }
+                for (const auto& record : it->second) {
+                    if (record.use != ViewUse::Storage && record.use != ViewUse::Attachment &&
+                        *record.view == bound) {
+                        slots.push_back({i, {record.info, record.use}});
+                        break;
+                    }
+                }
+            }
+        }
+        if (slots.empty()) {
+            note("skipped: no bound view of it found", 0);
+            continue;
+        }
+        auto& fc = feedback_copies[entry];
+        if (fc.source != entry->image.get() || !fc.copy) {
+            if (fc.copy) {
+                retired_feedback_copies.push_back(std::move(fc.copy)); // the GPU may still read it
+            }
+            fc = {};
+            auto made = MakeImage(entry->info, false);
+            if (!made.image) {
+                static std::atomic<u32> logged{};
+                if (Sample(logged)) {
+                    LOG_WARNING(Render_Vulkan, "FIX-AMD-003: no copy image for target {:#x}",
+                                entry->info.guest_address);
+                }
+                feedback_copies.erase(entry);
+                continue;
+            }
+            fc.copy = std::make_shared<Native::ImageEntry>();
+            fc.copy->info = entry->info;
+            fc.copy->image = std::move(made.image);
+            fc.copy->backend_usage = made.usage;
+            fc.copy->backend_features = made.features;
+            fc.source = entry->image.get();
+            if (feedback_copies_made++ < 8) {
+                LOG_WARNING(Render_Vulkan,
+                            "FIX-AMD-003: target {:#x} {}x{} is sampled by a draw into it: the "
+                            "draw reads a copy (no attachment feedback loop on this device)",
+                            entry->info.guest_address, entry->image->Desc().width,
+                            entry->image->Desc().height);
+            }
+        }
+        const auto& src_desc = entry->image->Desc();
+        const auto& dst_desc = fc.copy->image->Desc();
+        if (src_desc.width != dst_desc.width || src_desc.height != dst_desc.height ||
+            src_desc.samples != dst_desc.samples || src_desc.format != dst_desc.format) {
+            note("skipped: copy image differs", 0);
+            continue;
+        }
+        if (!copied) {
+            // The draw continues the open pass: it resumes after the copy without its clears.
+            resumed_pass = s.rendering && s.render == wanted;
+            current = s.render;
+            GlobalBarrier(); // ends the pass; what was drawn into the target is written
+            copied = true;
+        }
+        const vk::Image dst{Handle<VkImage_T>(fc.copy->image->NativeHandle())};
+        if (!fc.initialized) {
+            const vk::ImageMemoryBarrier2 transition{
+                .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                .dstAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+                .oldLayout = vk::ImageLayout::eUndefined,
+                .newLayout = vk::ImageLayout::eGeneral,
+                .image = dst,
+                .subresourceRange{.aspectMask = vk::ImageAspectFlagBits::eColor,
+                                  .baseMipLevel = 0,
+                                  .levelCount = VK_REMAINING_MIP_LEVELS,
+                                  .baseArrayLayer = 0,
+                                  .layerCount = VK_REMAINING_ARRAY_LAYERS},
+            };
+            s.cmd.pipelineBarrier2(vk::DependencyInfo{.imageMemoryBarrierCount = 1,
+                                                      .pImageMemoryBarriers = &transition});
+            fc.initialized = true;
+        }
+        const u32 mips = std::max<u32>(std::min(src_desc.mips, dst_desc.mips), 1u);
+        const u32 layers = std::max<u32>(std::min(src_desc.layers, dst_desc.layers), 1u);
+        for (u32 m = 0; m < mips; ++m) {
+            const vk::ImageCopy region{
+                .srcSubresource{.aspectMask = vk::ImageAspectFlagBits::eColor,
+                                .mipLevel = m,
+                                .baseArrayLayer = 0,
+                                .layerCount = layers},
+                .srcOffset = {0, 0, 0},
+                .dstSubresource{.aspectMask = vk::ImageAspectFlagBits::eColor,
+                                .mipLevel = m,
+                                .baseArrayLayer = 0,
+                                .layerCount = layers},
+                .dstOffset = {0, 0, 0},
+                .extent = {std::max(src_desc.width >> m, 1u), std::max(src_desc.height >> m, 1u),
+                           std::max(src_desc.depth >> m, 1u)},
+            };
+            CmdBuf{s.cmd}.copyImage(vk::Image{Handle<VkImage_T>(entry->image->NativeHandle())},
+                                    vk::ImageLayout::eGeneral, dst, vk::ImageLayout::eGeneral,
+                                    region);
+        }
+        ++s.commands;
+        // The draw's descriptors (written later, from b.images) name the copy's views.
+        for (const auto& [index, asked] : slots) {
+            if (const vk::ImageView view = View(*fc.copy, asked.first, asked.second)) {
+                b.images[index].imageView = view;
+            }
+        }
+        note("copied; slots rebound", slots.size());
+    }
+    if (copied) {
+        GlobalBarrier(); // the copies are written before the draw samples them
+        if (resumed_pass) {
+            RenderState resumed = current;
+            for (u32 i = 0; i < resumed.num_color_attachments; ++i) {
+                resumed.color_attachments[i].is_clear = false;
+            }
+            resumed.depth_stencil_attachment.depth_clear = false;
+            resumed.depth_stencil_attachment.stencil_clear = false;
+            BeginRendering(resumed);
+            s.render = current; // its clears are done; the same pass to the draw
+        }
+    }
+}
+
+static bool DepthExpandOn(const Instance& instance) {
+    static const int mode = [] {
+        const char* env = std::getenv("RYGT_MSAA_DEPTH_EXPAND");
+        if (env && env[0] == '0') {
+            return 0;
+        }
+        if (env && env[0] == '1') {
+            return 1;
+        }
+        return 2;
+    }();
+    return mode == 1 || (mode == 2 && !instance.IsAttachmentFeedbackLoopLayoutSupported());
+}
+
+bool NativeRenderer::EnsureExpandPipeline(u32 samples) {
+    if (samples == 0 || samples >= expand_pipelines.size()) {
+        return false;
+    }
+    if (expand_pipelines[samples]) {
+        return true;
+    }
+    const vk::Device dev = r.instance.GetDevice();
+    if (!expand_layout) {
+        expand_vs = Vulkan::CompileSPV(FS_TRI_VERT, dev);
+        expand_fs = Vulkan::CompileSPV(MS_IMAGE_BLIT_FRAG, dev);
+        const vk::DescriptorSetLayoutBinding binding{
+            .binding = 0,
+            .descriptorType = vk::DescriptorType::eSampledImage,
+            .descriptorCount = 1,
+            .stageFlags = vk::ShaderStageFlagBits::eFragment,
+        };
+        auto [set_result, set_layout] =
+            dev.createDescriptorSetLayoutUnique(vk::DescriptorSetLayoutCreateInfo{
+                .flags = vk::DescriptorSetLayoutCreateFlagBits::ePushDescriptorKHR,
+                .bindingCount = 1,
+                .pBindings = &binding,
+            });
+        if (set_result != vk::Result::eSuccess) {
+            return false;
+        }
+        expand_set_layout = std::move(set_layout);
+        const vk::DescriptorSetLayout set = *expand_set_layout;
+        auto [layout_result, layout] = dev.createPipelineLayoutUnique(vk::PipelineLayoutCreateInfo{
+            .setLayoutCount = 1,
+            .pSetLayouts = &set,
+        });
+        if (layout_result != vk::Result::eSuccess) {
+            return false;
+        }
+        expand_layout = std::move(layout);
+    }
+    const vk::PipelineInputAssemblyStateCreateInfo input_assembly{
+        .topology = vk::PrimitiveTopology::eTriangleList,
+    };
+    const vk::PipelineMultisampleStateCreateInfo multisampling{
+        .rasterizationSamples = static_cast<vk::SampleCountFlagBits>(samples),
+    };
+    const vk::PipelineDepthStencilStateCreateInfo depth_state{
+        .depthTestEnable = false,
+        .depthWriteEnable = false,
+        .depthCompareOp = vk::CompareOp::eAlways,
+    };
+    const std::array dynamic_states = {vk::DynamicState::eViewportWithCount,
+                                       vk::DynamicState::eScissorWithCount};
+    const vk::PipelineDynamicStateCreateInfo dynamic_info{
+        .dynamicStateCount = static_cast<u32>(dynamic_states.size()),
+        .pDynamicStates = dynamic_states.data(),
+    };
+    const std::array<vk::PipelineShaderStageCreateInfo, 2> stages{{
+        {.stage = vk::ShaderStageFlagBits::eVertex, .module = expand_vs, .pName = "main"},
+        {.stage = vk::ShaderStageFlagBits::eFragment, .module = expand_fs, .pName = "main"},
+    }};
+    const vk::Format color_format = vk::Format::eR32Sfloat;
+    const vk::PipelineRenderingCreateInfo rendering_ci{
+        .colorAttachmentCount = 1,
+        .pColorAttachmentFormats = &color_format,
+    };
+    const vk::PipelineColorBlendAttachmentState attachment{
+        .blendEnable = false,
+        .colorWriteMask = vk::ColorComponentFlagBits::eR | vk::ColorComponentFlagBits::eG |
+                          vk::ColorComponentFlagBits::eB | vk::ColorComponentFlagBits::eA,
+    };
+    const vk::PipelineColorBlendStateCreateInfo color_blending{
+        .attachmentCount = 1,
+        .pAttachments = &attachment,
+    };
+    const vk::PipelineViewportStateCreateInfo viewport_info{};
+    const vk::PipelineVertexInputStateCreateInfo vertex_input_info{};
+    const vk::PipelineRasterizationStateCreateInfo raster_state{.lineWidth = 1.f};
+    auto [pipeline_result, pipeline] =
+        dev.createGraphicsPipelineUnique(VK_NULL_HANDLE, vk::GraphicsPipelineCreateInfo{
+                                                             .pNext = &rendering_ci,
+                                                             .stageCount = 2,
+                                                             .pStages = stages.data(),
+                                                             .pVertexInputState = &vertex_input_info,
+                                                             .pInputAssemblyState = &input_assembly,
+                                                             .pViewportState = &viewport_info,
+                                                             .pRasterizationState = &raster_state,
+                                                             .pMultisampleState = &multisampling,
+                                                             .pDepthStencilState = &depth_state,
+                                                             .pColorBlendState = &color_blending,
+                                                             .pDynamicState = &dynamic_info,
+                                                             .layout = *expand_layout,
+                                                         });
+    if (pipeline_result != vk::Result::eSuccess) {
+        return false;
+    }
+    expand_pipelines[samples] = std::move(pipeline);
+    return true;
+}
+
+void NativeRenderer::ExpandSampledDepth(const Native::ImageEntry* attached,
+                                        const RenderState* wanted, DrawBindings& b) {
+    // FIX-AMD-006: GT7's PS4 Pro mode draws its checkerboard with a 2-sample depth buffer (AMD
+    // mixed attachment samples: 1-sample colour) that its atmosphere pass (and a compute pass
+    // before it) reads through an MSAA T#. On an RX 6900 XT, read in the GENERAL layout, 8x4-pixel
+    // blocks (the bottom halves of 8x8 tiles) came back as far: the pass painted only fog or
+    // sky there, in horizontal dashes all over the picture. A transfer copy of the depth read
+    // worse; the depth unit's own resolve (the frame dump's) reads it whole. So the work reads a
+    // picture made from that resolve: sample 0 resolved into a 1-sample depth image, drawn into
+    // an R32 colour image with the depth's sample count, whose view replaces the depth's.
+    if (b.sampled.empty() || !DepthExpandOn(r.instance)) {
+        return;
+    }
+    Stream& s = stream;
+    bool began = false;
+    bool resumed_pass = false;
+    RenderState current{};
+    boost::container::small_vector<const Native::ImageEntry*, 4> done;
+    for (const Native::ImageEntry* entry : b.sampled) {
+        if (!entry || !entry->image || !entry->info.props.is_depth || entry == attached ||
+            entry->image->Desc().samples <= 1 || std::ranges::find(done, entry) != done.end()) {
+            continue;
+        }
+        done.push_back(entry);
+        static std::atomic<u32> logged{};
+        const auto note = [&](const char* what, size_t n) {
+            const u32 k = logged.fetch_add(1, std::memory_order_relaxed);
+            if (k < 100 || k % 3000 == 0) {
+                LOG_WARNING(Render_Vulkan,
+                            "FIX-AMD-006 #{}: depth {:#x} {}x{} ({} samples) frame {} {} ({}; {})",
+                            k, entry->info.guest_address, entry->info.size.width,
+                            entry->info.size.height, entry->image->Desc().samples, frame, what, n,
+                            wanted ? "draw" : "dispatch");
+            }
+        };
+        const auto& sd = entry->image->Desc();
+        if (sd.layers != 1 || sd.dim != Native::Rhi::ImageDim::D2) {
+            note("skipped: layered", 0);
+            continue;
+        }
+        boost::container::small_vector<size_t, 4> slots;
+        {
+            std::scoped_lock lock{views_mutex};
+            const auto it = views.find(entry);
+            if (it == views.end()) {
+                note("skipped: no views recorded", 0);
+                continue;
+            }
+            for (size_t i = 0; i < b.images.size(); ++i) {
+                const vk::ImageView bound = b.images[i].imageView;
+                if (!bound) {
+                    continue;
+                }
+                for (const auto& record : it->second) {
+                    if (record.use != ViewUse::Storage && record.use != ViewUse::Attachment &&
+                        *record.view == bound) {
+                        slots.push_back(i);
+                        break;
+                    }
+                }
+            }
+        }
+        if (slots.empty()) {
+            note("skipped: no bound view of it found", 0);
+            continue;
+        }
+        auto& ex = depth_expands[entry];
+        if (ex.source != entry->image.get() || !ex.expanded) {
+            if (ex.resolved || ex.expanded) {
+                retired_depth_expands.push_back(std::move(ex)); // the GPU may still read them
+            }
+            ex = {};
+            if (!EnsureExpandPipeline(sd.samples)) {
+                note("skipped: no pipeline", 0);
+                depth_expands.erase(entry);
+                continue;
+            }
+            auto resolved_desc = sd;
+            resolved_desc.samples = 1;
+            resolved_desc.mips = 1;
+            ex.resolved = device->CreateImage(resolved_desc);
+            Native::Rhi::ImageDesc expanded_desc{};
+            expanded_desc.dim = Native::Rhi::ImageDim::D2;
+            expanded_desc.format =
+                Native::Rhi::FormatFromVk(static_cast<u32>(vk::Format::eR32Sfloat));
+            expanded_desc.width = sd.width;
+            expanded_desc.height = sd.height;
+            expanded_desc.samples = sd.samples;
+            expanded_desc.usage = Native::Rhi::ImageUsageColorTarget | Native::Rhi::ImageUsageSampled;
+            expanded_desc.name = "FIX-AMD-006 expanded depth";
+            ex.expanded = device->CreateImage(expanded_desc);
+            if (!ex.resolved || !ex.expanded) {
+                note("skipped: no images", 0);
+                depth_expands.erase(entry);
+                continue;
+            }
+            Native::Rhi::ImageViewDesc depth_view{};
+            depth_view.aspect = Native::Rhi::AspectDepth;
+            ex.source_view = device->CreateImageView(entry->image.get(), depth_view);
+            ex.resolved_view = device->CreateImageView(ex.resolved.get(), depth_view);
+            auto [view_result, view] =
+                r.instance.GetDevice().createImageViewUnique(vk::ImageViewCreateInfo{
+                    .image = vk::Image{Handle<VkImage_T>(ex.expanded->NativeHandle())},
+                    .viewType = vk::ImageViewType::e2D,
+                    .format = vk::Format::eR32Sfloat,
+                    .subresourceRange{.aspectMask = vk::ImageAspectFlagBits::eColor,
+                                      .baseMipLevel = 0,
+                                      .levelCount = 1,
+                                      .baseArrayLayer = 0,
+                                      .layerCount = 1},
+                });
+            if (!ex.source_view || !ex.resolved_view || view_result != vk::Result::eSuccess) {
+                note("skipped: no views", 0);
+                depth_expands.erase(entry);
+                continue;
+            }
+            ex.expanded_view = std::move(view);
+            ex.source = entry->image.get();
+        }
+        if (!began) {
+            resumed_pass = wanted && s.rendering && s.render == *wanted;
+            current = s.render;
+            GlobalBarrier(); // ends the pass; the depth writes before are done
+            began = true;
+        }
+        const vk::ImageAspectFlags depth_aspects =
+            entry->info.props.has_stencil
+                ? vk::ImageAspectFlagBits::eDepth | vk::ImageAspectFlagBits::eStencil
+                : vk::ImageAspectFlagBits::eDepth;
+        if (!ex.initialized) {
+            const std::array<vk::ImageMemoryBarrier2, 2> transitions{{
+                {.srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                 .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                 .dstAccessMask =
+                     vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+                 .oldLayout = vk::ImageLayout::eUndefined,
+                 .newLayout = vk::ImageLayout::eGeneral,
+                 .image = vk::Image{Handle<VkImage_T>(ex.resolved->NativeHandle())},
+                 .subresourceRange{.aspectMask = depth_aspects,
+                                   .baseMipLevel = 0,
+                                   .levelCount = 1,
+                                   .baseArrayLayer = 0,
+                                   .layerCount = 1}},
+                {.srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                 .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                 .dstAccessMask =
+                     vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+                 .oldLayout = vk::ImageLayout::eUndefined,
+                 .newLayout = vk::ImageLayout::eGeneral,
+                 .image = vk::Image{Handle<VkImage_T>(ex.expanded->NativeHandle())},
+                 .subresourceRange{.aspectMask = vk::ImageAspectFlagBits::eColor,
+                                   .baseMipLevel = 0,
+                                   .levelCount = 1,
+                                   .baseArrayLayer = 0,
+                                   .layerCount = 1}},
+            }};
+            s.cmd.pipelineBarrier2(vk::DependencyInfo{
+                .imageMemoryBarrierCount = static_cast<u32>(transitions.size()),
+                .pImageMemoryBarriers = transitions.data(),
+            });
+            ex.initialized = true;
